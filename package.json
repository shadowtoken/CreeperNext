{
  "name": "creeper-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup.mjs",
    "check:env": "tsx scripts/doctor.ts",
    "test:config": "tsx --test tests/configuration.test.ts",
    "test:auth-ui": "tsx --test tests/auth-failure.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:generate": "node --conditions=react-server scripts/auth-schema.mjs",
    "auth:migrate": "pnpm db:migrate",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:stop": "docker compose --profile test stop db-test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "pnpm test:config && pnpm test:auth-ui && pnpm test:architecture && pnpm test:db && node tests/support/build-test-app.mjs && node --test tests/build-boundaries.test.mjs tests/app.test.mjs",
    "test:responsive": "playwright test",
    "test:responsive:list": "playwright test --list",
    "test:responsive:install": "playwright install chromium",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@next/env": "16.3.3",
    "better-auth": "1.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "2.2.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "auth": "1.7.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "type": "module"
}
