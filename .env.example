# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_PROTOCOL=http
# Exact host allowlist. Append your LAN host explicitly, e.g. 192.168.1.20:3100.
BETTER_AUTH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,creeper.localhost:*
# Optional exact browser origins, comma-separated. Do not use wildcards.
BETTER_AUTH_TRUSTED_ORIGINS=
AUTH_COOKIE_PREFIX=creeper_next
# Local Compose credentials only; use managed secrets and TLS in production.
DATABASE_URL=postgresql://creeper:creeper_local_only@127.0.0.1:55432/creeper
# Optional direct endpoint for migrations when DATABASE_URL uses a pooler.
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=5
# Dedicated test server; the role needs CREATEDB. Never use a production server.
TEST_DATABASE_URL=postgresql://creeper:creeper_test_only@127.0.0.1:55433/creeper_test
SITE_URL=http://localhost:3000
# Development only: hostnames that may load Next.js dev assets from this server.
NEXT_ALLOWED_DEV_ORIGINS=127.0.0.1,creeper.localhost
